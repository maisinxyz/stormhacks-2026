NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_URL=http://localhost:3001
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
DATA_DIR=./data
# Development only. B1 supplies requireUser for real sessions.
DEV_AUTH=1
MOCK_GEN=1
MOCK_VOICE=1
MOCK_AGENT=1
MOCK_CONNECTORS=1
REQUIRE_LOGIN=0
SESSION_SECRET=
TOKEN_ENC_KEY=
WEB_ORIGIN=http://localhost:5173
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
ANTHROPIC_API_KEY=
# Required in production; at least 32 characters. Keep stable across restarts.
ASSET_SIGNING_SECRET=
ASSET_TTL_SECONDS=3600
# Free HF ZeroGPU queues can wait; 300000 leaves room for queue + ~25s generation.
GEN_TIMEOUT_MS=300000
# hf (free Hugging Face Space) or replicate (paid). Empty: replicate if REPLICATE_API_TOKEN is set, else hf.
IMAGE_TO_3D_PROVIDER=
HF_TRELLIS_SPACE=trellis-community/TRELLIS
# Free /gen/reference (drawing -> photoreal, sitting photo -> standing) when FAL_KEY is empty. Needs Kontext's /infer API.
HF_EDIT_SPACE=black-forest-labs/FLUX.1-Kontext-Dev
# Optional. Anonymous ZeroGPU allows roughly one generation per day; a token raises the quota (shared by both Spaces).
HF_TOKEN=
REPLICATE_API_TOKEN=
TRELLIS_VERSION=e8f6c45206993f297372f5436b90350817bd9b4a0d52d2a76df50c1c8afa2b3c
FAL_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_DOG=
ELEVENLABS_VOICE_CAT=
ELEVENLABS_VOICE_RODENT=
ELEVENLABS_VOICE_BIRD=
# Vision description uses a server-only OpenAI-compatible chat-completions endpoint.
VISION_API_KEY=
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_MODEL=gpt-4o-mini
