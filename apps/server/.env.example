NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_URL=http://localhost:3001
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
DATA_DIR=./data
# Development only. B1 supplies requireUser for real sessions.
DEV_AUTH=1
MOCK_GEN=1
