{
  "name": "@fetch/server",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:b1": "tsx watch src/agent/dev.ts",
    "test": "vitest run src && tsx --test test/*.test.ts",
    "test:b1": "vitest run src",
    "test:b2": "tsx --test test/*.test.ts",
    "test:smoke": "node test/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --packages=external --format=esm --target=node24 --outdir=dist --sourcemap",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@composio/core": "^0.22.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fetch/contracts": "workspace:*",
    "@gradio/client": "^2.7.1",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "sharp": "^0.34.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
